{
  "version": 2,
  "builds": [
    {
      "src": "api/auth/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/bills/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/customers.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/health.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/settings.py",
      "use": "@vercel/python"
    },
    {
      "src": "bill_generator.html",
      "use": "@vercel/static"
    },
    {
      "src": "manifest.json",
      "use": "@vercel/static"
    },
    {
      "src": "sw.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "*.ico",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/bills/bulk",
      "dest": "api/bills/bulk.py"
    },
    {
      "src": "/api/bills/(.*)",
      "dest": "api/bills/index.py"
    },
    {
      "src": "/api/bills",
      "dest": "api/bills/index.py"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "api/auth/$1.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/$1.py"
    },
    {
      "src": "/sw.js",
      "dest": "/sw.js"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/(.*\\.(?:png|ico|jpg|jpeg))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/bill_generator.html"
    }
  ]
}